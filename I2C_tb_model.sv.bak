`timescale 1ns/1ps

`ifndef I2C_TB_MODEL
`define I2C_TB_MODEL

`include "I2C_define.sv"
`include "I2C_interface.sv"

class I2C_model;

logic [`I2C_DATA_WIDTH-1:0] write_data;
logic [`I2C_ADDR_WIDTH-2:0] i2c_id;
logic [`I2C_ADDR_WIDTH-1:0] subaddr;
logic trans_en;
logic trans_type;
logic [`I2C_DATA_WIDTH-1:0] slave_reg [128][`I2C_ADDR_WIDTH];
logic wr_ready, rd_ready;

virtual I2C_interface i2c_int;

function new(virtual I2C_interface i2c_int);
    this.i2c_int = i2c_int;
    $display("[%t] I2C model : Initialized.", $time);
endfunction : new

extern task I2C_read_write();

endclass : I2C_model

//READ-WRITE OPERATION
task I2C_model:: I2C_read_write();

 //128 slaves registers table
logic [0:26] receive_reg;
logic [0:18] resp_reg;
int i;

forever begin 
    wr_ready = 0;
    rd_ready = 0;
    @(i2c_int.SIO_D_input == 1)
    if (i2c_int.SIO_C != 1 ) begin
        $display("I2C START TRANSACTION CLOCK ERROR!!!");
        $stop;
    end
    @(negedge i2c_int.SIO_C)
    if (i2c_int.SIO_D_input != 0) begin
        $display("I2C START TRANSACTION DATA ERROR!!!");
        $stop;
    end
    for(i = 0; i < 18; i++) begin
        @(negedge i2c_int.SIO_C) 
        receive_reg[i] = i2c_int.SIO_D_input; 
    end
    @(negedge i2c_int.SIO_C)
    receive_reg[7] = i2c_int.SIO_D_input;
    if (receive_reg[7] == 0) begin
        for(i = 8; i < 27; i++) begin
            @(negedge i2c_int.SIO_C) 
            receive_reg[i] = i2c_int.SIO_D_input; 
        end
    end
    else begin
        for(i = 8; i < 18; i++) begin
            @(negedge i2c_int.SIO_C) 
            receive_reg[i] = i2c_int.SIO_D_input; 
        end
    end
    if (receive_reg[0:6] > 7'b1111111) begin
        $display("ERROR : I2C SLAVE ID OUT OF RANGE");
        $stop;
    end
    if (receive_reg[7] == 0) begin
        slave_reg[receive_reg[0:6]][receive_reg[9:16]] = receive_reg[18:25];
        wr_ready = 1;
		#20ns;
    end
    else begin
        resp_reg = {receive_reg[0:6],1'b1,1'bX,slave_reg[receive_reg[0:6]][receive_reg[9:16]],1'b1,1'b0};
        for(i=18;i>=0;i--) begin
            @(negedge i2c_int.SIO_C)
            i2c_int.SIO_D_EN = 1;
            i2c_int.SIO_D_output = resp_reg[i];
        end
        i2c_int.SIO_D_EN = 0;
        i2c_int.SIO_D_output = 1'bz;
        rd_ready = 1;
    end
end

endtask :I2C_read_write

`endif